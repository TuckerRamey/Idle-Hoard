    "typecheck": "tsc --noEmit",
    "art:placeholder": "node scripts/gen-placeholder-art.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.14"
  }
}
